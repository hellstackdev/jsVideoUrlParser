From 289bfcb707d9b4a295cf5ead07071fadf3c1276b Mon Sep 17 00:00:00 2001
From: jeffrey-omega <>
Date: Fri, 22 May 2026 16:09:35 +0200
Subject: [PATCH 8/9] chore: upgrade build tooling, modernize rollup config; CI
 uses npm ci without legacy peer deps

---
 .github/workflows/ci.yml |  2 +-
 package.json             | 26 +++++++++++++-------------
 rollup.config.js         |  2 ++
 3 files changed, 16 insertions(+), 14 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 47f4f48..c499e7b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -27,7 +27,7 @@ jobs:
           cache: npm
 
       - name: Install dependencies
-        run: npm ci --legacy-peer-deps
+        run: npm ci
 
       - name: Run tests
         run: npm run test
diff --git a/package.json b/package.json
index 480bedd..ccc8b5e 100755
--- a/package.json
+++ b/package.json
@@ -47,20 +47,20 @@
     "url": "https://github.com/Zod-/jsVideoUrlParser/issues"
   },
   "devDependencies": {
-    "@babel/core": "^7.16.0",
-    "@babel/eslint-parser": "^7.16.3",
-    "@babel/preset-env": "^7.9.0",
-    "@rollup/plugin-babel": "^5.3.0",
-    "@rollup/plugin-commonjs": "^11.0.2",
-    "@rollup/plugin-node-resolve": "^7.1.1",
-    "babel-preset-minify": "^0.5.1",
-    "eslint": "^8.2.0",
-    "eslint-plugin-jest": "^23.8.2",
-    "jest": "^26.6.3",
-    "jest-expect-message": "^1.0.2",
-    "rollup": "^2.2.0",
+    "@babel/core": "^7.29.0",
+    "@babel/eslint-parser": "^7.28.6",
+    "@babel/preset-env": "^7.29.5",
+    "@rollup/plugin-babel": "^7.0.0",
+    "@rollup/plugin-commonjs": "^29.0.2",
+    "@rollup/plugin-node-resolve": "^16.0.3",
+    "babel-preset-minify": "^0.5.2",
+    "eslint": "^8.57.1",
+    "eslint-plugin-jest": "^29.15.2",
+    "jest": "^30.4.2",
+    "jest-expect-message": "^1.1.3",
+    "rollup": "^4.60.4",
     "rollup-plugin-terser": "^7.0.2",
-    "typescript": "^3.9.7"
+    "typescript": "^6.0.3"
   },
   "scripts": {
     "test": "jest --coverage --config jestconfig.js",
diff --git a/rollup.config.js b/rollup.config.js
index 617a701..c08563d 100644
--- a/rollup.config.js
+++ b/rollup.config.js
@@ -15,6 +15,7 @@ export default [
       resolve(),
       commonjs(),
       babel({
+        babelHelpers: 'bundled',
         presets: [['@babel/env', {'modules': false}]],
       }),
     ],
@@ -29,6 +30,7 @@ export default [
       resolve(),
       commonjs(),
       babel({
+        babelHelpers: 'bundled',
         presets: [['@babel/env', {'modules': false}]],
       }),
       terser(),
-- 
2.47.3

