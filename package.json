{
  "name": "js-video-url-parser",
  "version": "1.0.0",
  "description": "A parser to extract provider, video id, starttime and others from YouTube, Vimeo, ... urls",
  "main": "./lib/index.js",
  "module": "./dist/jsVideoUrlParser.esm.js",
  "browser": "./dist/jsVideoUrlParser.js",
  "types": "./lib/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./dist/jsVideoUrlParser.esm.js",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zod-/jsVideoUrlParser.git"
  },
  "keywords": [
    "parser",
    "YouTube",
    "Facebook",
    "Vimeo",
    "Dailymotion",
    "Twitch",
    "CanalPlus",
    "Youku",
    "Coub",
    "Wistia",
    "SoundCloud",
    "Ted",
    "Tiktok",
    "Loom"
  ],
  "author": {
    "name": "Julian Hangstörfer",
    "email": "jhangstoerfer@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zod-/jsVideoUrlParser/issues"
  },
  "files": [
    "lib",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "jest --coverage --config jestconfig.js",
    "build": "rollup -c rollup.config.js",
    "typecheck": "tsc -p lib/tsconfig.json --pretty false",
    "ci": "npm run lint:check && npm run test && npm run build && npm run typecheck",
    "all": "npm audit && npm run ci"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/js": "^9.14.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-jest": "^28.8.3",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "rollup": "^4.24.4",
    "typescript": "^5.6.3"
  }
}
